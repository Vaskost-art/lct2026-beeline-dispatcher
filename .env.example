# Ключи Яндекса. Скопируйте в .env и подставьте свои.
# .env в репозиторий не попадает - он в .gitignore.
#
# Кабинет разработчика Яндекса, тариф «JavaScript API и HTTP Геокодер».
# Ключи РАЗНЫЕ: один для карты в браузере, другой для геокодера в скрипте.

# Карта в интерфейсе. Без него рисуется собственная схема.
YANDEX_MAPS_API_KEY=

# Геокодирование адресов скриптом scripts/geocode.py.
YANDEX_GEOCODER_API_KEY=

# Журнал рабочего дня в PostgreSQL. Необязателен: без базы сервис держит
# день в памяти и предупреждает об этом в меню. По умолчанию:
# postgresql+psycopg://postgres@localhost:5432/dispatcher
# DATABASE_URL=
